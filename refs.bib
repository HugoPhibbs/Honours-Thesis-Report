@incollection{BUSATO2017163,
title = {Chapter 7 - Graph algorithms on GPUs},
editor = {Hamid Sarbazi-Azad},
booktitle = {Advances in GPU Research and Practice},
publisher = {Morgan Kaufmann},
address = {Boston},
pages = {163-198},
year = {2017},
series = {Emerging Trends in Computer Science and Applied Computing},
isbn = {978-0-12-803738-6},
doi = {https://doi.org/10.1016/B978-0-12-803738-6.00007-0},
url = {https://www.sciencedirect.com/science/article/pii/B9780128037386000070},
author = {F. Busato and N. Bombieri},
keywords = {Graph algorithms, BFS, SSSP, APSP, Load balancing},
abstract = {This chapter introduces the topic of graph algorithms on graphics processing units (GPUs). It starts by presenting and comparing the most important data structures and techniques applied for representing and analyzing graphs on state-of-the-art GPUs. It then presents the theory and an updated review of the most efficient implementations of graph algorithms for GPUs. In particular, the chapter focuses on graph traversal algorithms (breadth-first search), single-source shortest path (Djikstra, Bellman-Ford, delta stepping, hybrids), and all-pairs shortest path (Floyd-Warshall). By the end of the chapter, load balancing and memory access techniques are discussed through an overview of their main issues and management techniques.}
}

