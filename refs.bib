@Inbook{Bapat2010,
title="Adjacency Matrix",
bookTitle="Graphs and Matrices",
year="2010",
publisher="Springer London",
address="London",
pages="25--44",
abstract="Let G be a graph with V(G) = {\{}1,⋯,n{\}} and E(G) = {\{}e1,⋯,em{\}}: The adjacency matrix of G, denoted by A(G), is the n{\texttimes}n matrix defined as follows. The rows and the columns of A(G) are indexed by V(G): If i ≠ j then the (i, j)-entry of A(G) is 0 for vertices i and j nonadjacent, and the (i, j)-entry is 1 for i and j adjacent. The (i, i)-entry of A(G) is 0 for i = 1,⋯,n. We often denote A(G) simply by A.",
isbn="978-1-84882-981-7",
doi="10.1007/978-1-84882-981-7_3",
url="https://doi.org/10.1007/978-1-84882-981-7_3"
}

